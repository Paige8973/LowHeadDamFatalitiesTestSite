<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Low Head Dam Safety</title>
    <link rel="stylesheet" href="style.css" />
</head>
<body>
    <header>
        <h1>Low Head Dam Safety</h1>
        <img src="images/tagline.png" alt="Stay informed. Stay safe." class="tagline-img" />
    </header>

    <section class="email-signup">
        <h2>Sign Up for Safety Notices</h2>
        <form>
            <input type="email" placeholder="Enter your email" required />
            <button type="submit">Subscribe</button>
        </form>
    </section>

    <section class="products">
        <h2>Order Safety Merchandise</h2>
        <div class="product-grid">
            <div class="product">
                <img src="images/tshirt.png" alt="T-Shirt" />
                <p>T-Shirts</p>
                <button class="cart-btn">Add to Cart</button>
            </div>
            <div class="product">
                <img src="https://github.com/Paige8973/LowHeadDamFatalitiesTestSite/blob/main/DLTFHYD(Final).png" alt="Don't Let the Flow Hold You Down" />
                <p>Don't Let the Flow Hold You Down</p>
                <button class="cart-btn">Add to Cart</button>
            </div>
            <div class="product">
                <img src="https://github.com/Paige8973/LowHeadDamFatalitiesTestSite/blob/main/CCCD(circle).jpg" alt="Circling Currents, Certain Danger" />
                <p>Circling Current, Certain Danger</p>
                <button class="cart-btn">Add to Cart</button>
            </div>
            <div class="product">
                <img src="https://github.com/Paige8973/LowHeadDamFatalitiesTestSite/blob/main/BTBW(SPIKY).png" alt="Beware the Backwash" />
                <p>Beware the Backwash</p>
                <button class="cart-btn">Add to Cart</button>
            </div>
            <div class="product">
                <img src="" alt="Water Bottle" />
                <p>Water Bottles</p>
                <button class="cart-btn">Add to Cart</button>
            </div>
            <div class="product">
                <img src="images/light.png" alt="Waterproof Light" />
                <p>Waterproof Lights</p>
                <button class="cart-btn">Add to Cart</button>
            </div>
            <div class="product">
                <img src="images/carabiner.png" alt="Carabiner" />
                <p>Carabiner</p>
                <button class="cart-btn">Add to Cart</button>
            </div>
            <div class="product">
                <img src="https://github.com/Paige8973/LowHeadDamFatalitiesTestSite/blob/main/QuarterZipJacket.jpeg" alt="Quarter Zip Jacket" />
                <p>Quarter Zip Jackets</p>
                <button class="cart-btn">Add to Cart</button>
            </div>
        </div>
    </section>

    <section class="flyer-download">
        <h2>Download Safety Flyer</h2>
        <a class="download-btn" href="flyer.pdf" download>Download PDF</a>
    </section>

    <footer>
        <p>© 2025 Low Head Dam Safety Initiative</p>
    </footer>
</body>
</html>

